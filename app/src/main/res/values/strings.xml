    <string name="onboarding_notifications_title">Want a gentle nudge when it’s time?</string>
    <string name="onboarding_notifications_body">Ebb only notifies you about your own plans. Without it, everything still works — you just won’t get reminders.</string>
    <string name="onboarding_notifications_allow">Allow notifications</string>
    <string name="onboarding_notifications_title_granted">Notifications are on ✓</string>
    <string name="onboarding_notifications_title_denied">Notifications are off</string>
    <string name="onboarding_notifications_body_granted">You’ll get gentle nudges when plans start. Change this anytime in Settings.</string>
    <string name="onboarding_notifications_body_denied">Reminders won’t buzz. You can turn them on later in Settings → Reminders.</string>
    <string name="onboarding_notifications_open_settings">Open notification settings</string>

    <string name="onboarding_alarms_title">So reminders arrive on time</string>
    <string name="onboarding_alarms_body">Android needs your OK for “Alarms &amp; reminders” — otherwise reminders can arrive 10 minutes late. Without it, Ebb still works; timing is just looser.</string>
    <string name="onboarding_alarms_tip">On the next screen, switch on Allow setting alarms and reminders, then come back.</string>
    <string name="onboarding_alarms_open_setting">Open setting</string>

    <string name="onboarding_calendar_title">See your calendar on your day?</string>
    <string name="onboarding_calendar_body">Ebb can show events from your phone’s calendars as fixed blocks. It only reads them, never changes them. Skip it and Ebb works the same.</string>
